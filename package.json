{
  "name": "typescript_with_playwrigth",
  "version": "1.0.0",
  "description": "demo framework Typescript with Playwright",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "pnpm bddgen && pnpm playwright test --grep",
    "test:smoke": "pnpm bddgen && pnpm playwright test --grep @smoke",
    "test:regression": "pnpm bddgen && pnpm playwright test --grep @regression",
    "generate:report": "pnpm exec playwright show-report",
    "debug":"pnpm bddgen && pnpm exec playwright test --debug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarceloMansilla/TypeScript_With_Playwrigth.git"
  },
  "author": "Marcelo Mansilla",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MarceloMansilla/TypeScript_With_Playwrigth/issues"
  },
  "homepage": "https://github.com/MarceloMansilla/TypeScript_With_Playwrigth#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.9.3"
  }
}
